<?xml version="1.0" encoding="utf-8"?>
<!--  Classic 8-bit RPG dialog-box look: outer white border, inner dark fill with a thin accent stripe. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outer white border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- inner dark background with purple accent border -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#000022" />
            <stroke android:width="2dp" android:color="#7b2ff7" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>

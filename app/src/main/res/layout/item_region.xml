<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:background="@drawable/rpg_dialog_bg"
    android:elevation="4dp">

    <!-- ── Row 1: Icon  |  Region name + Bardo title  |  Lock/Clear badge ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_region_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:textSize="34sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tv_region_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tv_region_enemy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="#CC88FF"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Lock / clear status badge -->
        <TextView
            android:id="@+id/tv_region_modes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- ── Row 2: Description / intro teaser ───────────────────────────── -->
    <TextView
        android:id="@+id/tv_region_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="#AAAACC"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- ── Row 3: Fragment status ───────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_region_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#FFDD44"
        android:layout_marginTop="4dp" />

</LinearLayout>
